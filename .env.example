# Copy this file to .env and fill in your keys. Never commit the real .env.

# Required for Phase 1 (PDF extraction) — Groq API key from https://console.groq.com/keys
# (either variable name works; GROQ_API_KEY is preferred)
GROQ_API_KEY=gsk_...

# Optional overrides
# GROQ_MODEL=llama-3.3-70b-versatile   # text mode: any Groq chat model
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_INSTRUCTOR_MODE=JSON    # JSON | MD_JSON | TOOLS
# EXTRACT_VISION=false   # set true + use a vision-capable GROQ_MODEL to read pages as images
